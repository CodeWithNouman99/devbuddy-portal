# Copy this file to ".env" and fill in real values.
# NEVER commit the real .env file (it is listed in .gitignore).

# Port the API listens on
PORT=5000

# "development" or "production"
NODE_ENV=development

# MongoDB Atlas connection string (Atlas -> Connect -> Drivers)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/devbuddy?retryWrites=true&w=majority

# Long random string used to sign login tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-string

# The URL of the React app (the only origin CORS will allow)
CLIENT_URL=http://localhost:5173

# Send the auth cookie only over HTTPS. Chrome/Edge/Firefox accept this on
# http://localhost too. Set to "false" only if your browser (e.g. Safari)
# refuses to store the cookie during local development.
COOKIE_SECURE=true

# Set to 1 when deployed behind ONE reverse proxy (Render, Railway, Nginx...)
# so that req.ip shows the real visitor IP. Leave 0 locally.
TRUST_PROXY=0

# First admin account, created by "npm run seed"
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@yourcompany.com
ADMIN_PASSWORD=change-this-to-a-strong-password

# Optional: a real manager account created/updated by "npm run seed".
# MANAGER_PHONE is their WhatsApp number (any format: 0300 1234567,
# +92 300 1234567...). It's cleaned to digits like developer numbers. n8n
# sends this manager stuck alerts and the weekly report on it.
# Re-running the seed with a new MANAGER_PHONE updates the number.
MANAGER_NAME=
MANAGER_EMAIL=
MANAGER_PASSWORD=
MANAGER_PHONE=

# Password for the demo HR/manager accounts created by "npm run seed -- --demo"
# (at least 10 characters). Only needed if you use --demo.
DEMO_PASSWORD=change-this-demo-password

# WhatsApp number given to the demo managers by "npm run seed -- --demo"
# (any format, cleaned to digits, e.g. 923001234567). Use your own test phone.
# Leave empty and the demo managers have no phone. Real managers (MANAGER_*)
# are never changed by this.
DEMO_MANAGER_PHONE=

# n8n: called by the SERVER (never the browser) after a developer is added.
# Leave the URL empty to skip it; the developer is still saved.
N8N_NEW_DEVELOPER_WEBHOOK=https://your-n8n-instance.com/webhook/devbuddy-new-developer
# Shared secret sent in the "x-devbuddy-secret" header. Check it in n8n so
# nobody else can trigger your workflow. Generate like JWT_SECRET.
N8N_WEBHOOK_SECRET=replace-me-with-another-long-random-string
